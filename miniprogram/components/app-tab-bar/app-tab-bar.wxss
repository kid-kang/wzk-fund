.tab-bar {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #0b1018;
  border-top: 1rpx solid rgba(238, 242, 255, 0.1);
  box-sizing: border-box;
}

.tab-bar.theme-light {
  background: #eef1f8;
  border-top-color: rgba(16, 20, 28, 0.08);
}

.tab-bar.theme-dark {
  background: #0b1018;
  border-top-color: rgba(238, 242, 255, 0.1);
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-top: 8rpx;
}

.tab-item-hover {
  opacity: 0.72;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  color: #9aa3b5;
}

.tab-item.is-active .tab-text {
  color: #7b88ff;
  font-weight: 640;
}

.theme-light .tab-text {
  color: #7a8494;
}

.theme-light .tab-item.is-active .tab-text {
  color: #4f5dff;
}

.theme-dark .tab-text {
  color: #9aa3b5;
}

.theme-dark .tab-item.is-active .tab-text {
  color: #7b88ff;
}
