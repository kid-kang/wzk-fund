.tab-root,
.page-scroller {
  height: 100%;
  width: 100%;
  background: var(--bg);
}

.watch-page {
  /* 覆盖全局 .page-scroller .page 的 48rpx，避免被吃掉 */
  padding-bottom: 48rpx !important;
}

/* 实体占位：保证最后一只基金能滚到添加钮上方 */
.fab-spacer {
  width: 100%;
  height: calc(180rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  pointer-events: none;
}

.watch-page.is-skeleton {
  display: flex;
  flex-direction: column;
}

.watch-page.is-skeleton .desk-sync-fill {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.section-empty {
  padding: 24rpx 0 40rpx;
}

.err {
  margin-bottom: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 59, 69, 0.1);
  color: var(--rise);
  font-size: 22rpx;
}

/* 分组标题：对齐持仓页 fund-divider */
.fund-divider {
  position: relative;
  margin: 18rpx 8rpx 14rpx;
  min-height: 40rpx;
}

.fund-divider.is-first {
  margin-top: 6rpx;
}

.fund-divider-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 40rpx;
  padding: 0 24rpx;
}

.fund-divider-line {
  flex: 1;
  height: 1rpx;
}

.fund-divider-line:first-child {
  background: linear-gradient(90deg, transparent, rgba(36, 53, 82, 0.18));
}

.fund-divider-line:last-child {
  background: linear-gradient(90deg, rgba(36, 53, 82, 0.18), transparent);
}

.fund-divider-text {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #243552;
  letter-spacing: 0.12em;
  font-weight: 680;
}

.theme-dark .fund-divider-line:first-child {
  background: linear-gradient(90deg, transparent, rgba(197, 208, 230, 0.2));
}

.theme-dark .fund-divider-line:last-child {
  background: linear-gradient(90deg, rgba(197, 208, 230, 0.2), transparent);
}

.theme-dark .fund-divider-text {
  color: #c5d0e6;
}

.list-gap {
  margin-top: 4rpx;
}

/* 自选无金额行：整体更扁，标题与标签拉开 */
.list-gap .dense-row {
  min-height: 88rpx;
  padding: 10rpx 14rpx;
}

.list-gap .dense-main {
  flex: 0 1 42%;
  max-width: 42%;
  justify-content: center;
  gap: 14rpx;
}

.list-gap .spark {
  height: 40px;
  min-width: 140rpx;
}

.list-gap .dense-right {
  width: 120rpx;
}

.pct-lg {
  font-size: 28rpx;
  font-weight: 760;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

/* 右下悬浮添加：遮挡基金时半透明，滑到底无遮挡时不透明 */
.fab-add {
  position: fixed;
  right: 36rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 100;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  background:
    radial-gradient(120% 100% at 28% 18%, rgba(255, 255, 255, 0.92) 0%, transparent 46%),
    linear-gradient(165deg, rgba(255, 255, 255, 0.88) 0%, rgba(238, 241, 248, 0.78) 100%);
  border: 1rpx solid rgba(79, 93, 255, 0.22);
  box-shadow:
    0 14rpx 36rpx rgba(28, 40, 80, 0.14),
    0 0 0 6rpx var(--accent-soft),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  opacity: 0.58;
}

.fab-add-hover {
  opacity: 0.72;
  transform: scale(0.96);
}

.theme-dark .fab-add {
  color: var(--accent);
  background:
    radial-gradient(120% 100% at 28% 18%, rgba(255, 255, 255, 0.12) 0%, transparent 48%),
    linear-gradient(165deg, rgba(40, 48, 68, 0.92) 0%, rgba(22, 27, 39, 0.88) 100%);
  border: 1rpx solid rgba(123, 136, 255, 0.34);
  box-shadow:
    0 14rpx 36rpx rgba(0, 0, 0, 0.42),
    0 0 0 6rpx var(--accent-soft),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}
