.tab-root,
.page-scroller {
  height: 100%;
  width: 100%;
  background: var(--bg);
}

.hold-page {
  padding-bottom: 48rpx !important;
}

.fab-spacer {
  width: 100%;
  height: calc(180rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  pointer-events: none;
}

.fab-add {
  position: fixed;
  right: 36rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 100;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  background:
    radial-gradient(120% 100% at 28% 18%, rgba(255, 255, 255, 0.92) 0%, transparent 46%),
    linear-gradient(165deg, rgba(255, 255, 255, 0.88) 0%, rgba(238, 241, 248, 0.78) 100%);
  border: 1rpx solid rgba(79, 93, 255, 0.22);
  box-shadow:
    0 14rpx 36rpx rgba(28, 40, 80, 0.14),
    0 0 0 6rpx var(--accent-soft),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  opacity: 0.58;
}

.fab-add-hover {
  opacity: 0.72;
  transform: scale(0.96);
}

.theme-dark .fab-add {
  color: var(--accent);
  background:
    radial-gradient(120% 100% at 28% 18%, rgba(255, 255, 255, 0.12) 0%, transparent 48%),
    linear-gradient(165deg, rgba(40, 48, 68, 0.92) 0%, rgba(22, 27, 39, 0.88) 100%);
  border: 1rpx solid rgba(123, 136, 255, 0.34);
  box-shadow:
    0 14rpx 36rpx rgba(0, 0, 0, 0.42),
    0 0 0 6rpx var(--accent-soft),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.section-empty {
  padding: 12rpx 0 28rpx;
}

.gold-empty {
  padding-top: 4rpx;
}

/* 分区收益条：冷蓝水晶玻璃 */
.section-pnl-bar {
  position: relative;
  display: flex;
  align-items: center;
  margin: -4rpx 8rpx 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  background:
    linear-gradient(
      118deg,
      rgba(255, 255, 255, 0.92) 0%,
      rgba(232, 241, 255, 0.78) 38%,
      rgba(244, 247, 252, 0.88) 72%,
      rgba(255, 255, 255, 0.7) 100%
    );
  box-shadow:
    0 8rpx 22rpx rgba(22, 119, 255, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.section-pnl-bar::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18%;
  bottom: 18%;
  width: 4rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: linear-gradient(
    180deg,
    rgba(22, 119, 255, 0.15) 0%,
    rgba(22, 119, 255, 0.72) 50%,
    rgba(123, 136, 255, 0.2) 100%
  );
  pointer-events: none;
}

.section-pnl-bar::after {
  content: "";
  position: absolute;
  right: -20%;
  top: -60%;
  width: 55%;
  height: 160%;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    rgba(22, 119, 255, 0.1) 0%,
    transparent 68%
  );
  pointer-events: none;
}

.section-pnl-cell {
  position: relative;
  z-index: 1;
  flex: 0 1 auto;
  width: auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  padding: 2rpx 0;
}

.section-pnl-gap {
  position: relative;
  z-index: 1;
  width: 1rpx;
  flex: 0 0 1rpx;
  align-self: stretch;
  margin: 4rpx 14rpx;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(22, 119, 255, 0.22) 30%,
    rgba(123, 136, 255, 0.18) 70%,
    transparent 100%
  );
}

.section-pnl-label {
  font-size: 18rpx;
  color: #7a879c;
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.section-pnl-label-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 2rpx;
  max-width: 100%;
  min-width: 0;
  height: 28rpx;
}

.section-pnl-label-row .section-pnl-label {
  line-height: 28rpx;
  height: 28rpx;
  display: inline-flex;
  align-items: center;
}

.section-pnl-tip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  line-height: 1;
}

.section-pnl-tip-hover {
  opacity: 0.65;
}

.section-pnl-value {
  font-size: 26rpx;
  font-weight: 720;
  color: #243552;
  line-height: 1.15;
}

/* 境内 / QDII：四列等宽，label / value 上下 */
.section-pnl-bar.is-quad {
  padding-left: 16rpx;
  padding-right: 12rpx;
}

.section-pnl-bar.is-quad .section-pnl-cell {
  flex: 1 1 0;
  width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.section-pnl-bar.is-quad .section-pnl-gap {
  margin: 4rpx 8rpx;
}

.section-pnl-bar.is-quad .section-pnl-label {
  white-space: nowrap;
}

.theme-dark .section-pnl-bar {
  border-color: rgba(123, 136, 255, 0.18);
  background:
    linear-gradient(
      118deg,
      rgba(34, 44, 68, 0.92) 0%,
      rgba(28, 42, 72, 0.78) 40%,
      rgba(22, 32, 54, 0.9) 74%,
      rgba(30, 38, 58, 0.72) 100%
    );
  box-shadow:
    0 10rpx 28rpx rgba(0, 0, 0, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.07);
}

.theme-dark .section-pnl-bar::before {
  background: linear-gradient(
    180deg,
    rgba(123, 136, 255, 0.2) 0%,
    rgba(22, 119, 255, 0.85) 50%,
    rgba(123, 136, 255, 0.25) 100%
  );
}

.theme-dark .section-pnl-bar::after {
  background: radial-gradient(
    ellipse at center,
    rgba(79, 93, 255, 0.18) 0%,
    transparent 68%
  );
}

.theme-dark .section-pnl-gap {
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(123, 136, 255, 0.28) 30%,
    rgba(22, 119, 255, 0.2) 70%,
    transparent 100%
  );
}

.theme-dark .section-pnl-label {
  color: #8a93a8;
}

.theme-dark .section-pnl-value {
  color: #e8eef8;
}

/* QDII 分区标题与上方实时组拉开 */
.fund-divider.is-follow {
  margin-top: 28rpx;
}

.err {
  margin-bottom: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 59, 69, 0.1);
  color: var(--rise);
  font-size: 22rpx;
}

/* 基金分区标题：左右等宽留白保证标题居中，右侧线不压加号 */
.fund-divider {
  --action-inset: 12rpx;
  position: relative;
  margin: 6rpx 8rpx 14rpx;
  min-height: 40rpx;
}

.fund-divider-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 40rpx;
  padding: 0 48rpx;
}

.fund-divider-line {
  flex: 1;
  height: 1rpx;
}

.fund-divider-line:first-child {
  background: linear-gradient(90deg, transparent, rgba(36, 53, 82, 0.18));
}

.fund-divider-line:last-child {
  background: linear-gradient(90deg, rgba(36, 53, 82, 0.18), transparent);
}

.fund-divider-title {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-shrink: 0;
  height: 40rpx;
}

.fund-divider-text {
  flex-shrink: 0;
  height: 40rpx;
  font-size: 22rpx;
  line-height: 40rpx;
  color: #243552;
  letter-spacing: 0.12em;
  font-weight: 680;
}

.fund-divider-tip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  line-height: 1;
  /* van-icon 字形视觉重心偏上，略下移对齐标题 */
  transform: translateY(2rpx);
}

.fund-divider-tip-hover {
  opacity: 0.6;
}

.section-action {
  position: absolute;
  right: var(--action-inset, 12rpx);
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  background: transparent;
  line-height: 1;
}

.section-action-hover {
  opacity: 0.5;
}

.theme-dark .fund-divider-line:first-child {
  background: linear-gradient(90deg, transparent, rgba(197, 208, 230, 0.2));
}

.theme-dark .fund-divider-line:last-child {
  background: linear-gradient(90deg, rgba(197, 208, 230, 0.2), transparent);
}

.theme-dark .fund-divider-text {
  color: #c5d0e6;
}

.list-gap {
  margin-top: 4rpx;
}

.gold-divider {
  --action-inset: 12rpx;
  position: relative;
  margin: 22rpx 8rpx 14rpx;
  min-height: 40rpx;
}

.gold-divider-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 40rpx;
  padding: 0 48rpx;
}

.gold-divider-line {
  flex: 1;
  height: 1rpx;
}

.gold-divider-line:first-child {
  background: linear-gradient(90deg, transparent, rgba(184, 137, 45, 0.45));
}

.gold-divider-line:last-child {
  background: linear-gradient(90deg, rgba(184, 137, 45, 0.45), transparent);
}

/* 标题锁：标题 + 占比同轨同高，光学居中 */
.gold-divider-title {
  --gold-title-size: 22rpx;
  --gold-title-track: 32rpx;
  --gold-title-ink: #b8892d;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: var(--gold-title-track);
}

.gold-divider-text {
  flex-shrink: 0;
  height: var(--gold-title-track);
  font-size: var(--gold-title-size);
  line-height: var(--gold-title-track);
  color: var(--gold-title-ink);
  letter-spacing: 0.12em;
  font-weight: 680;
}

.gold-share {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: var(--gold-title-track);
}

.gold-share-mark {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: conic-gradient(
    #b8892d 0 42%,
    #d4b56a 42% 72%,
    #e8d5a8 72% 100%
  );
  -webkit-mask: radial-gradient(circle at center, transparent 36%, #000 38%);
  mask: radial-gradient(circle at center, transparent 36%, #000 38%);
}

.gold-share-pct {
  letter-spacing: 0.06em;
}

.theme-dark .gold-divider-title {
  --gold-title-ink: #b8892d;
}

.theme-dark .gold-share-mark {
  background: conic-gradient(
    #b8892d 0 42%,
    #d4b56a 42% 72%,
    #e8d5a8 72% 100%
  );
}

.theme-dark .gold-divider-line:first-child {
  background: linear-gradient(90deg, transparent, rgba(184, 137, 45, 0.4));
}

.theme-dark .gold-divider-line:last-child {
  background: linear-gradient(90deg, rgba(184, 137, 45, 0.4), transparent);
}

.gold-wrap {
  margin: 0 0 8rpx;
  border-radius: var(--radius);
  overflow: hidden;
}

.gold-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 8rpx 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(184, 137, 45, 0.28);
  box-shadow:
    0 12rpx 32rpx rgba(90, 70, 30, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.gold-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #d4b56a, #b8892d 55%, #8a6a32);
}

.gold-metrics {
  display: grid;
  grid-template-columns: 1.1fr 1.1fr 0.95fr 1.15fr;
  gap: 6rpx;
  align-items: start;
  flex: 1;
  min-width: 0;
}

.gm {
  min-width: 0;
  padding-right: 6rpx;
}

.gm + .gm {
  border-left: 1rpx solid rgba(176, 138, 72, 0.2);
  padding-left: 10rpx;
}

.gm-k {
  display: block;
  font-size: 20rpx;
  font-weight: 620;
  color: inherit;
  margin-bottom: 6rpx;
  letter-spacing: 0.02em;
}

.gm-v {
  font-size: 26rpx;
  font-weight: 720;
  color: inherit;
  line-height: 1.15;
}

.gold-card-go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  opacity: 0.55;
}

.gold-card-hover {
  opacity: 0.88;
}

.gm.gold-price {
  color: #b8892d;
}

.gm.gold-price .gm-v {
  font-weight: 760;
  letter-spacing: -0.02em;
}

.theme-dark .gold-card {
  background: rgba(28, 34, 48, 0.88);
  border-color: rgba(184, 137, 45, 0.28);
}

.theme-dark .gold-card::before {
  background: linear-gradient(180deg, #d4b56a, #b8892d 55%, #8a6a32);
}

.theme-dark .gm + .gm {
  border-left-color: rgba(160, 140, 100, 0.16);
}

.theme-dark .gm.gold-price {
  color: #b8892d;
}
