<view class="tab-root theme-{{theme}}">
  <scroll-view class="page-scroller" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view class="page theme-{{theme}} hold-page" style="min-height: {{contentMinHeight}}px">
      <view class="err" wx:if="{{error}}">{{error}}</view>

      <desk-sync wx:if="{{loading && !hasPortfolio && !error}}" theme="{{theme}}" variant="hold" />

      <block wx:elif="{{!loading && !hasPortfolio}}">
        <view class="section-empty">
          <van-empty image="search" description="暂无持仓，点右下角 + 添加" />
        </view>
      </block>

      <!-- 境内基金列表 -->
      <block wx:if="{{hasRealtime}}">
        <view class="fund-divider">
          <view class="fund-divider-main">
            <view class="fund-divider-line"></view>
            <text class="fund-divider-text">境内基金({{realtimeList.length}})</text>
            <view class="fund-divider-line"></view>
          </view>
        </view>
        <view class="section-pnl-bar is-quad">
          <view class="section-pnl-cell">
            <text class="section-pnl-label">持仓</text>
            <text class="mono section-pnl-value">{{hideAmounts ? '***' : domesticAmountText}}</text>
          </view>
          <view class="section-pnl-gap" aria-hidden="true"></view>
          <view class="section-pnl-cell">
            <text class="section-pnl-label">持仓占比</text>
            <text class="mono section-pnl-value">{{domesticShareText}}</text>
          </view>
          <view class="section-pnl-gap" aria-hidden="true"></view>
          <view class="section-pnl-cell">
            <text class="section-pnl-label">当日实时收益</text>
            <text class="mono section-pnl-value">{{hideAmounts ? '***' : domesticPnlText}}</text>
          </view>
          <view class="section-pnl-gap" aria-hidden="true"></view>
          <view class="section-pnl-cell">
            <text class="section-pnl-label">当日实时收益率</text>
            <text class="mono section-pnl-value">{{domesticPnlPctText}}</text>
          </view>
        </view>

        <view class="list-gap">
          <view class="swipe-row" wx:for="{{realtimeList}}" wx:key="code">
            <van-swipe-cell right-width="{{130}}">
              <view class="glass dense-row tone-{{item.pnlClass}}">
                <view class="dense-row-skin" aria-hidden="true">
                  <text class="card-mark mono">{{item.codeMark}}</text>
                </view>
                <view class="confirm-seal" wx:if="{{item.confirmedUpdated && !item.showDiscloseTime}}"
                  catchtap="onOpenQaTips" data-q="badge-cn" hover-class="qa-hit-hover" aria-label="净值已更新，查看说明">
                  <view class="confirm-seal-fold" aria-hidden="true"></view>
                  <view class="confirm-seal-icon">
                    <van-icon name="certificate" size="10px" color="#F5F8FF" />
                  </view>
                </view>
                <view class="dense-asof" wx:if="{{item.showDiscloseTime}}" catchtap="onOpenQaTips" data-q="badge-qdii"
                  hover-class="qa-hit-hover" aria-label="官方披露日期，查看说明">
                  <text>{{item.discloseTimeText}}</text>
                  <view class="dense-asof-icon">
                    <van-icon name="certificate" size="11px" color="{{theme === 'dark' ? '#8a93a8' : '#8a93a3'}}" />
                  </view>
                </view>
                <view class="dense-main">
                  <view class="name-clip is-link" data-code="{{item.code}}" data-name="{{item.name}}"
                    catchtap="onOpenTrend">
                    <text class="dense-name">{{item.name}}</text>
                  </view>
                  <view class="meta-row">
                    <text class="dense-amount mono">{{hideAmounts ? '***' : item.amountText}}</text>
                    <view class="weight-chip">
                      <view class="pie-icon" aria-hidden="true"></view>
                      <text class="dense-weight mono">{{item.weightText}}</text>
                    </view>
                    <view class="yield-chip" wx:if="{{item.hasCostYield}}">
                      <van-icon name="gold-coin-o" size="11px" color="{{theme === 'dark' ? '#7a8496' : '#8a93a3'}}" />
                      <text class="mono dense-yield">{{item.costPctText}}</text>
                    </view>
                  </view>
                  <view class="tag-row" wx:if="{{item.hasTags}}">
                    <text class="sector-tag is-link" wx:for="{{item.sectorTags}}" wx:for-item="tag" wx:key="name"
                      data-name="{{tag.name}}" data-sector="{{tag.sectorCode}}" data-mapping="{{tag.mappingCode}}"
                      catchtap="onOpenSector">{{tag.name}}</text>
                  </view>
                </view>

                <view class="spark" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="onOpenTrend">
                  <spark-line wx:if="{{item.spark.length}}" values="{{item.spark}}" breaks="{{item.sparkBreaks}}"
                    theme="{{theme}}" height="{{56}}" toneDelta="{{item.realtimePercent}}"
                    label="{{item.trendDateText}}" labelShort="{{item.trendDateShort}}"
                    labelValue="{{item.trendPctText}}" labelTone="{{item.trendPctTone}}" />
                </view>

                <view class="dense-right">
                  <text class="mono dense-pct {{item.pctClass}}" catchtap="onOpenQaTips" data-q="a-share"
                    hover-class="qa-hit-hover" aria-label="查看涨跌幅说明">{{item.pctText}}</text>
                  <text class="mono dense-pnl {{hideAmounts ? 'flat' : item.pnlClass}}">{{hideAmounts ? '***' :
                    item.pnlText}}</text>
                </view>
              </view>
              <view slot="right" class="swipe-actions">
                <view class="swipe-btn edit" data-code="{{item.code}}" data-name="{{item.name}}"
                  data-amount="{{item.amount}}" data-cost="{{item.cost}}" bindtap="onEdit">
                  <van-icon name="edit" size="17px" color="{{theme === 'dark' ? '#C5D0E6' : '#243552'}}" />
                  <text class="swipe-label">编辑</text>
                </view>
                <view class="swipe-btn del" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="onRemove">
                  <van-icon name="delete-o" size="17px" color="{{theme === 'dark' ? '#FF6B7A' : '#D7263D'}}" />
                  <text class="swipe-label">删除</text>
                </view>
              </view>
            </van-swipe-cell>
          </view>
        </view>
      </block>

      <!-- QDII · 海外 -->
      <block wx:if="{{hasDelayed}}">
        <view class="fund-divider is-follow">
          <view class="fund-divider-main">
            <view class="fund-divider-line"></view>
            <view class="fund-divider-title">
              <text class="fund-divider-text">QDII · 海外({{delayedList.length}})</text>
              <view class="fund-divider-tip" catchtap="onOpenQaTips" data-q="add-hold"
                hover-class="fund-divider-tip-hover" aria-label="查看 QDII 申购与收益说明">
                <van-icon name="question-o" size="14px"
                  color="{{theme === 'dark' ? 'rgba(154,168,255,0.9)' : 'rgba(79,93,255,0.75)'}}" />
              </view>
            </view>
            <view class="fund-divider-line"></view>
          </view>
        </view>

        <view class="section-pnl-bar is-quad">
          <view class="section-pnl-cell">
            <text class="section-pnl-label">持仓</text>
            <text class="mono section-pnl-value">{{hideAmounts ? '***' : foreignAmountText}}</text>
          </view>
          <view class="section-pnl-gap" aria-hidden="true"></view>
          <view class="section-pnl-cell">
            <text class="section-pnl-label">持仓占比</text>
            <text class="mono section-pnl-value">{{foreignShareText}}</text>
          </view>
          <view class="section-pnl-gap" aria-hidden="true"></view>
          <view class="section-pnl-cell">
            <view class="section-pnl-label-row">
              <text class="section-pnl-label">当前日收益</text>
              <view class="section-pnl-tip" catchtap="onOpenQaTips" data-q="qdii-pnl"
                hover-class="section-pnl-tip-hover" aria-label="查看当前日收益说明">
                <van-icon name="question-o" size="12px"
                  color="{{theme === 'dark' ? 'rgba(154,168,255,0.85)' : 'rgba(79,93,255,0.72)'}}" />
              </view>
            </view>
            <text class="mono section-pnl-value">{{hideAmounts ? '***' : foreignPnlText}}</text>
          </view>
          <view class="section-pnl-gap" aria-hidden="true"></view>
          <view class="section-pnl-cell">
            <view class="section-pnl-label-row">
              <text class="section-pnl-label">当前日收益率</text>
              <view class="section-pnl-tip" catchtap="onOpenQaTips" data-q="qdii-pnl"
                hover-class="section-pnl-tip-hover" aria-label="查看当前日收益率说明">
                <van-icon name="question-o" size="12px"
                  color="{{theme === 'dark' ? 'rgba(154,168,255,0.85)' : 'rgba(79,93,255,0.72)'}}" />
              </view>
            </view>
            <text class="mono section-pnl-value">{{foreignPnlPctText}}</text>
          </view>
        </view>

        <view class="list-gap">
          <view class="swipe-row" wx:for="{{delayedList}}" wx:key="code">
            <van-swipe-cell right-width="{{130}}">
              <view class="glass dense-row tone-{{item.pnlClass}}">
                <view class="dense-row-skin" aria-hidden="true">
                  <text class="card-mark mono">{{item.codeMark}}</text>
                </view>
                <view class="confirm-seal" wx:if="{{item.confirmedUpdated && !item.showDiscloseTime}}"
                  catchtap="onOpenQaTips" data-q="badge-cn" hover-class="qa-hit-hover" aria-label="净值已更新，查看说明">
                  <view class="confirm-seal-fold" aria-hidden="true"></view>
                  <view class="confirm-seal-icon">
                    <van-icon name="certificate" size="10px" color="#F5F8FF" />
                  </view>
                </view>
                <view class="dense-asof" wx:if="{{item.showDiscloseTime}}" catchtap="onOpenQaTips" data-q="badge-qdii"
                  hover-class="qa-hit-hover" aria-label="官方披露日期，查看说明">
                  <text>{{item.discloseTimeText}}</text>
                  <view class="dense-asof-icon">
                    <van-icon name="certificate" size="11px" color="{{theme === 'dark' ? '#8a93a8' : '#8a93a3'}}" />
                  </view>
                </view>
                <view class="dense-main">
                  <view class="name-clip is-link" data-code="{{item.code}}" data-name="{{item.name}}"
                    catchtap="onOpenTrend">
                    <text class="dense-name">{{item.name}}</text>
                  </view>
                  <view class="meta-row">
                    <text class="dense-amount mono">{{hideAmounts ? '***' : item.amountText}}</text>
                    <view class="weight-chip">
                      <view class="pie-icon" aria-hidden="true"></view>
                      <text class="dense-weight mono">{{item.weightText}}</text>
                    </view>
                    <view class="yield-chip" wx:if="{{item.hasCostYield}}">
                      <van-icon name="gold-coin-o" size="11px" color="{{theme === 'dark' ? '#7a8496' : '#8a93a3'}}" />
                      <text class="mono dense-yield">{{item.costPctText}}</text>
                    </view>
                  </view>
                  <view class="tag-row" wx:if="{{item.hasTags}}">
                    <text class="sector-tag is-link" wx:for="{{item.sectorTags}}" wx:for-item="tag" wx:key="name"
                      data-name="{{tag.name}}" data-sector="{{tag.sectorCode}}" data-mapping="{{tag.mappingCode}}"
                      catchtap="onOpenSector">{{tag.name}}</text>
                  </view>
                </view>

                <view class="spark" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="onOpenTrend">
                  <spark-line wx:if="{{item.spark.length}}" values="{{item.spark}}" breaks="{{item.sparkBreaks}}"
                    theme="{{theme}}" height="{{56}}" toneDelta="{{item.realtimePercent}}"
                    label="{{item.trendDateText}}" labelShort="{{item.trendDateShort}}"
                    labelValue="{{item.trendPctText}}" labelTone="{{item.trendPctTone}}" />
                </view>

                <view class="dense-right">
                  <text class="mono dense-pct {{item.pctClass}}" catchtap="onOpenQaTips" data-q="a-share"
                    hover-class="qa-hit-hover" aria-label="查看涨跌幅说明">{{item.pctText}}</text>
                  <text class="mono dense-pnl {{hideAmounts ? 'flat' : item.pnlClass}}">{{hideAmounts ? '***' :
                    item.pnlText}}</text>
                </view>
              </view>
              <view slot="right" class="swipe-actions">
                <view class="swipe-btn edit" data-code="{{item.code}}" data-name="{{item.name}}"
                  data-amount="{{item.amount}}" data-cost="{{item.cost}}" bindtap="onEdit">
                  <van-icon name="edit" size="17px" color="{{theme === 'dark' ? '#C5D0E6' : '#243552'}}" />
                  <text class="swipe-label">编辑</text>
                </view>
                <view class="swipe-btn del" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="onRemove">
                  <van-icon name="delete-o" size="17px" color="{{theme === 'dark' ? '#FF6B7A' : '#D7263D'}}" />
                  <text class="swipe-label">删除</text>
                </view>
              </view>
            </van-swipe-cell>
          </view>
        </view>
      </block>

      <block wx:if="{{showGold}}">
        <view class="gold-divider">
          <view class="gold-divider-main">
            <view class="gold-divider-line"></view>
            <view class="gold-divider-title">
              <text class="gold-divider-text">持仓黄金</text>
              <view class="gold-share" wx:if="{{goldWeightText}}">
                <view class="gold-share-mark" aria-hidden="true"></view>
                <text class="gold-divider-text gold-share-pct">{{goldWeightText}}</text>
              </view>
            </view>
            <view class="gold-divider-line"></view>
          </view>
          <view class="section-action" catchtap="onEditGold" hover-class="section-action-hover" aria-label="设置黄金">
            <van-icon name="setting-o" size="15px" color="{{theme === 'dark' ? '#B8A078' : '#5A3E18'}}" />
          </view>
        </view>

        <desk-sync wx:if="{{loading && goldPriceText === '--' && !error}}" theme="{{theme}}" variant="gold" />

        <view class="gold-wrap" wx:else>
          <view class="glass gold-card" catchtap="onOpenGoldTrend" hover-class="gold-card-hover" aria-label="查看金价走势">
            <view class="gold-metrics">
              <view class="gm gold-price">
                <text class="gm-k">总价值</text>
                <text class="mono gm-v">{{hideAmounts ? '***' : goldValueText}}</text>
              </view>
              <view class="gm gold-price">
                <text class="gm-k">收益</text>
                <text class="mono gm-v">{{hideAmounts ? '***' : goldCostText}}</text>
              </view>
              <view class="gm gold-price">
                <text class="gm-k">收益率</text>
                <text class="mono gm-v">{{goldCostPctText}}</text>
              </view>
              <view class="gm gold-price">
                <text class="gm-k">实时金价</text>
                <text class="mono gm-v">{{goldPriceText}}</text>
              </view>
            </view>
            <view class="gold-card-go" aria-hidden="true">
              <van-icon name="arrow" size="14px" color="#B8892D" />
            </view>
          </view>
        </view>
      </block>

      <view class="fab-spacer" wx:if="{{hasPortfolio}}" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <view class="fab-add" catchtap="onAdd" hover-class="fab-add-hover" aria-label="添加持仓">
    <van-icon name="plus" size="22px" color="{{theme === 'dark' ? '#7b88ff' : '#4f5dff'}}" />
  </view>
</view>