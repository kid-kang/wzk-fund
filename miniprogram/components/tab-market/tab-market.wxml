<view class="tab-root theme-{{theme}}">
  <scroll-view
    class="page-scroller"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
    <view
      class="page theme-{{theme}} {{loading && !market && !indices.length && !error ? 'is-skeleton' : ''}}"
      style="min-height: {{contentMinHeight}}px"
    >
      <view class="err" wx:if="{{error}}">{{error}}</view>
      <desk-sync
        wx:if="{{loading && !market && !indices.length && !error}}"
        class="desk-sync-fill"
        theme="{{theme}}"
        variant="market"
        min-height="{{contentMinHeight}}"
      />

      <view class="market-stack" wx:if="{{market || indices.length}}">
        <!-- 涨跌温度：独立一行，在指数之上 -->
        <view class="glass pulse" wx:if="{{market}}">
          <view class="pulse-meta">
            <view class="pulse-side">
              <text class="pulse-k rise">涨</text>
              <text class="mono pulse-p rise">{{market.upDown.upPctText}}</text>
            </view>
            <view class="pulse-side pulse-side-r">
              <text class="mono pulse-p fall">{{market.upDown.downPctText}}</text>
              <text class="pulse-k fall">跌</text>
            </view>
          </view>
          <view class="pulse-track">
            <view class="pulse-fill" style="width: {{market.upDown.upBarPct}}%;"></view>
          </view>
        </view>

        <!-- 指数报价板 -->
        <view class="glass index-board" wx:if="{{indices.length}}">
          <view
            class="index-cell"
            wx:for="{{indices}}"
            wx:key="code"
            data-code="{{item.code}}"
            data-name="{{item.name}}"
            bindtap="onOpenIndex"
          >
            <text class="index-name">{{item.shortName}}</text>
            <text class="mono index-pct {{item.pctClass}}">{{item.pctText}}</text>
          </view>
        </view>

        <!-- 板块榜 -->
        <view class="glass board-rank" wx:if="{{market}}">
          <view class="rank-head">
            <text class="rank-title">今日板块榜</text>
            <view class="rank-tabs">
              <view
                class="rank-tab {{boardTab === 'hot' ? 'is-on' : ''}}"
                data-tab="hot"
                bindtap="onBoardTab"
              >热搜</view>
              <view
                class="rank-tab {{boardTab === 'gainers' ? 'is-on' : ''}}"
                data-tab="gainers"
                bindtap="onBoardTab"
              >涨幅</view>
            </view>
          </view>
          <view class="rank-list">
            <view class="rank-row" wx:for="{{boardList}}" wx:key="code">
              <text class="rank-no {{item.topClass}}">{{item.rankText}}</text>
              <text class="rank-name">{{item.name}}</text>
              <text class="mono rank-pct {{item.pctClass}}">{{item.pctText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
