/* Crystal Ticker
 * 默认即深色：冷启动时 WXSS 先于 JS，若 page 默认浅色必然闪白。
 * 亮色通过 .theme-light 覆盖。
 */
page {
  --bg: #0b1018;
  --panel: rgba(28, 34, 48, 0.78);
  --ink: #eef2ff;
  --muted: #8b93a7;
  --line: rgba(238, 242, 255, 0.1);
  /* 与 utils/palette.js 同步：红涨 / 玉青绿跌 */
  --rise: #ff6b7a;
  --fall: #4bb892;
  --accent: #7b88ff;
  --accent-soft: rgba(123, 136, 255, 0.18);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-shadow:
    0 20rpx 56rpx rgba(0, 0, 0, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  --radius: 24rpx;
  --cell-background-color: transparent;
  --cell-text-color: var(--ink);
  --cell-label-color: var(--muted);
  --cell-value-color: var(--muted);
  --cell-right-icon-color: var(--muted);
  --cell-active-color: rgba(238, 242, 255, 0.06);
  --cell-border-color: var(--line);
  --field-label-color: var(--muted);
  --field-input-text-color: var(--ink);
  --field-placeholder-text-color: rgba(139, 147, 167, 0.7);
  background-color: #0b1018;
  background:
    linear-gradient(180deg, #0b1018 0%, #0b1018 120rpx, transparent 280rpx),
    radial-gradient(800rpx 480rpx at 12% 30%, rgba(79, 93, 255, 0.2), transparent 58%),
    radial-gradient(600rpx 400rpx at 96% 40%, rgba(61, 214, 160, 0.08), transparent 52%),
    var(--bg);
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.35;
  box-sizing: border-box;
  font-family: "PingFang SC", "HarmonyOS Sans", "Noto Sans SC", system-ui, sans-serif;
}

page.theme-dark,
.theme-dark {
  --bg: #0b1018;
  --panel: rgba(28, 34, 48, 0.78);
  --ink: #eef2ff;
  --muted: #8b93a7;
  --line: rgba(238, 242, 255, 0.1);
  --rise: #ff6b7a;
  --fall: #4bb892;
  --accent: #7b88ff;
  --accent-soft: rgba(123, 136, 255, 0.18);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-shadow:
    0 20rpx 56rpx rgba(0, 0, 0, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  --cell-background-color: transparent;
  --cell-text-color: var(--ink);
  --cell-label-color: var(--muted);
  --cell-value-color: var(--muted);
  --cell-right-icon-color: var(--muted);
  --cell-active-color: rgba(238, 242, 255, 0.06);
  --cell-border-color: var(--line);
  --field-label-color: var(--muted);
  --field-input-text-color: var(--ink);
  --field-placeholder-text-color: rgba(139, 147, 167, 0.7);
  background-color: #0b1018;
  background:
    linear-gradient(180deg, #0b1018 0%, #0b1018 120rpx, transparent 280rpx),
    radial-gradient(800rpx 480rpx at 12% 30%, rgba(79, 93, 255, 0.2), transparent 58%),
    radial-gradient(600rpx 400rpx at 96% 40%, rgba(61, 214, 160, 0.08), transparent 52%),
    var(--bg);
  color: var(--ink);
}

page.theme-light,
.theme-light {
  --bg: #eef1f8;
  --panel: rgba(255, 255, 255, 0.72);
  --ink: #10141c;
  --muted: #7a8494;
  --line: rgba(16, 20, 28, 0.08);
  --rise: #d7263d;
  --fall: #0b6b4f;
  --accent: #4f5dff;
  --accent-soft: rgba(79, 93, 255, 0.12);
  --glass-border: rgba(255, 255, 255, 0.72);
  --glass-shadow:
    0 18rpx 50rpx rgba(28, 40, 80, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  --cell-background-color: transparent;
  --cell-text-color: var(--ink);
  --cell-label-color: var(--muted);
  --cell-value-color: var(--muted);
  --cell-right-icon-color: var(--muted);
  --cell-active-color: rgba(16, 20, 28, 0.04);
  --cell-border-color: var(--line);
  --field-label-color: var(--muted);
  --field-input-text-color: var(--ink);
  --field-placeholder-text-color: rgba(122, 132, 148, 0.7);
  background-color: #eef1f8;
  background:
    linear-gradient(180deg, #eef1f8 0%, #eef1f8 120rpx, transparent 280rpx),
    radial-gradient(900rpx 520rpx at 12% 28%, rgba(79, 93, 255, 0.14), transparent 58%),
    radial-gradient(700rpx 480rpx at 96% 36%, rgba(20, 184, 122, 0.08), transparent 52%),
    radial-gradient(600rpx 400rpx at 50% 100%, rgba(255, 59, 69, 0.05), transparent 55%),
    var(--bg);
  color: var(--ink);
}

view,
text,
scroll-view,
input,
button {
  box-sizing: border-box;
}

/* iOS 上 enhanced + show-scrollbar=false 偶发仍画出指示条，用 CSS 兜底隐藏 */
::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  color: transparent !important;
  background: transparent !important;
}

.page {
  min-height: 100vh;
  width: 100%;
  max-width: 100%;
  padding: 12rpx 20rpx 48rpx;
  overflow-x: hidden;
}

/* 单壳内 Tab 内容区：高度由壳页面板约束；内容至少铺满一屏可视区 */
.page-scroller {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.page-scroller .page {
  /* min-height 由各 tab 组件按「窗口高 - TabBar」内联设置 */
  padding-bottom: 48rpx;
}

/* 二级页：自定义导航 + 禁用回弹的内容区 */
.subpage-root {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /* 实色底，避免返回右滑动画时左侧透出窗口默认浅色 */
  background-color: var(--bg);
  background: var(--bg);
  overflow: hidden;
}

.subpage-nav {
  flex-shrink: 0;
  width: 100%;
}

.subpage-scroller {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 0;
  box-sizing: border-box;
  background: var(--bg);
}

.subpage-scroller .page {
  min-height: 100%;
  box-sizing: border-box;
}

.glass {
  background: var(--panel);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius);
  box-shadow: var(--glass-shadow);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
}

.rise {
  color: var(--rise);
}

.fall {
  color: var(--fall);
}

.flat {
  color: var(--muted);
}

.mono {
  font-family: "DIN Alternate", "Tabular Numbers", "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.swipe-actions {
  display: flex;
  height: 100%;
  align-items: stretch;
  gap: 2rpx;
}

.swipe-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 68px;
  height: 100%;
  /* 与行情笺同系：霜面 + 细斜纹 */
  background:
    linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(236, 241, 250, 0.88) 100%
    ),
    repeating-linear-gradient(
      -16deg,
      transparent 0 9rpx,
      rgba(36, 53, 82, 0.03) 9rpx 10rpx
    );
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.65);
}

.swipe-label {
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 0.12em;
  line-height: 1;
}

.swipe-btn.edit {
  color: #243552;
  background:
    linear-gradient(
      160deg,
      rgba(230, 236, 248, 0.95) 0%,
      rgba(210, 220, 238, 0.92) 100%
    ),
    repeating-linear-gradient(
      -16deg,
      transparent 0 9rpx,
      rgba(36, 53, 82, 0.04) 9rpx 10rpx
    );
}

.swipe-btn.edit .swipe-label {
  color: #243552;
}

.swipe-btn.del {
  color: #d7263d;
  background:
    linear-gradient(
      160deg,
      rgba(255, 236, 238, 0.95) 0%,
      rgba(248, 220, 224, 0.92) 100%
    ),
    repeating-linear-gradient(
      -16deg,
      transparent 0 9rpx,
      rgba(215, 38, 61, 0.05) 9rpx 10rpx
    );
}

.swipe-btn.del .swipe-label {
  color: #b01f33;
}

.theme-dark .swipe-btn {
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.theme-dark .swipe-btn.edit {
  background:
    linear-gradient(
      160deg,
      rgba(48, 58, 78, 0.96) 0%,
      rgba(36, 44, 62, 0.94) 100%
    ),
    repeating-linear-gradient(
      -16deg,
      transparent 0 9rpx,
      rgba(238, 242, 255, 0.03) 9rpx 10rpx
    );
  color: #c5d0e6;
}

.theme-dark .swipe-btn.edit .swipe-label {
  color: #c5d0e6;
}

.theme-dark .swipe-btn.del {
  background:
    linear-gradient(
      160deg,
      rgba(72, 36, 42, 0.95) 0%,
      rgba(56, 28, 34, 0.94) 100%
    ),
    repeating-linear-gradient(
      -16deg,
      transparent 0 9rpx,
      rgba(255, 107, 122, 0.05) 9rpx 10rpx
    );
  color: #ff6b7a;
}

.theme-dark .swipe-btn.del .swipe-label {
  color: #ff6b7a;
}

.dense-row {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  min-height: 112rpx;
  /* 行情笺：霜面斜纹 + 冷雾底，避开纯白卡片 */
  background:
    linear-gradient(
      118deg,
      rgba(255, 255, 255, 0.78) 0%,
      rgba(236, 241, 250, 0.62) 48%,
      rgba(245, 248, 255, 0.72) 100%
    ),
    repeating-linear-gradient(
      -16deg,
      transparent 0 9rpx,
      rgba(36, 53, 82, 0.028) 9rpx 10rpx
    );
  border-color: rgba(120, 140, 180, 0.18);
  box-shadow:
    0 12rpx 28rpx rgba(36, 53, 82, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
}

/* 水印/涨跌晕单独层裁剪，不给整卡 overflow，以免裁掉 canvas */
.dense-row-skin {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  border-radius: inherit;
  pointer-events: none;
}

.dense-row-skin::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 42%;
}

.dense-row.tone-rise .dense-row-skin::after {
  background: linear-gradient(90deg, transparent, rgba(215, 38, 61, 0.06));
}

.dense-row.tone-fall .dense-row-skin::after {
  background: linear-gradient(90deg, transparent, rgba(11, 107, 79, 0.07));
}

.dense-row.tone-flat .dense-row-skin::after {
  background: linear-gradient(90deg, transparent, rgba(79, 93, 255, 0.04));
}

.card-mark {
  position: absolute;
  right: 14%;
  top: 50%;
  font-size: 68rpx;
  font-weight: 820;
  line-height: 1;
  letter-spacing: 0.08em;
  color: rgba(36, 53, 82, 0.06);
  transform: translateY(-50%) rotate(-12deg);
  transform-origin: center center;
  user-select: none;
}

.dense-main,
.spark,
.dense-right {
  position: relative;
  z-index: 1;
}

.dense-main {
  flex: 0 1 38%;
  max-width: 38%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  overflow: visible;
}

/* 名称区域：单行超出直接铺开显示（可盖住走势图），不省略、不换行、不走马灯 */
.name-clip.is-link {
  position: relative;
  z-index: 2;
}

.name-clip {
  position: relative;
  width: 100%;
  max-width: none;
  min-width: 0;
  overflow: visible;
  z-index: 3;
}

/* 夜票深蓝字：小一号、略收字距，像行情机标签 */
.dense-name {
  display: block;
  width: max-content;
  max-width: none;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 680;
  letter-spacing: 0.03em;
  color: #243552;
  white-space: nowrap;
  overflow: visible;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 10rpx;
  min-width: 0;
}

.dense-amount {
  font-size: 24rpx;
  font-weight: 700;
  color: #5c6678;
}

.weight-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

/* 石色甜甜圈：点明占比，不抢涨跌红绿 */
.pie-icon {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: conic-gradient(
    #8a93a3 0 42%,
    #b8c0cc 42% 72%,
    #d5dae3 72% 100%
  );
  -webkit-mask: radial-gradient(circle at center, transparent 36%, #000 38%);
  mask: radial-gradient(circle at center, transparent 36%, #000 38%);
}

.dense-weight {
  font-size: 20rpx;
  font-weight: 620;
  color: #8a93a3;
}

.theme-dark .dense-amount {
  color: #9aa3b5;
}

.theme-dark .dense-weight {
  color: #7a8496;
}

.theme-dark .pie-icon {
  background: conic-gradient(
    #7a8496 0 42%,
    #5a6478 42% 72%,
    #9aa3b5 72% 100%
  );
}

/* 标签单行铺开，超出可盖住走势图 */
.tag-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  width: max-content;
  max-width: none;
  min-width: 0;
  overflow: visible;
  position: relative;
  z-index: 3;
}

/*
 * 已确认：行情笺右上角斜角验章（仅图标）
 * 色相对齐 section-pnl-bar::before 的蓝靛渐变中段
 */
.confirm-seal {
  --seal-ink: rgba(22, 119, 255, 0.42);
  position: absolute;
  top: 0;
  right: 0;
  width: 52rpx;
  height: 52rpx;
  z-index: 4;
  border-radius: 0 var(--radius) 0 0;
  overflow: hidden;
}

.confirm-seal-fold {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 52rpx 52rpx 0;
  border-color: transparent var(--seal-ink) transparent transparent;
}

/* 直角三角心：距顶/右各约 1/3 边长 */
.confirm-seal-icon {
  position: absolute;
  left: 66.67%;
  top: 33.33%;
  z-index: 1;
  width: 22rpx;
  height: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%) rotate(12deg);
  transform-origin: center center;
}

.theme-dark .confirm-seal {
  --seal-ink: rgba(123, 136, 255, 0.5);
}

.sector-tag {
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--muted);
  background: rgba(16, 20, 28, 0.05);
  border: 1rpx solid var(--line);
  white-space: nowrap;
  overflow: visible;
}

.sector-tag.is-link {
  color: var(--text);
}

.theme-dark .sector-tag {
  background: rgba(238, 242, 255, 0.06);
}

/* QDII 净值日：贴卡片右上角，脱离文档流，不占涨跌纵向空间 */
.dense-asof {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  z-index: 4;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  font-weight: 560;
  letter-spacing: 0.02em;
  line-height: 1;
  color: #8a93a3;
  pointer-events: auto;
}

.dense-asof-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
}

.theme-dark .dense-asof {
  color: #8a93a8;
}


.spark {
  flex: 1 1 auto;
  min-width: 160rpx;
  height: 56px;
  align-self: center;
  display: block;
  position: relative;
  z-index: 2;
  overflow: visible;
}

.dense-right {
  flex-shrink: 0;
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
  text-align: right;
}

.dense-pnl,
.dense-pct {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.15;
}

.qa-hit-hover {
  opacity: 0.72;
}

.theme-dark .dense-row {
  background:
    linear-gradient(
      118deg,
      rgba(32, 40, 56, 0.92) 0%,
      rgba(24, 30, 44, 0.88) 52%,
      rgba(28, 36, 52, 0.9) 100%
    ),
    repeating-linear-gradient(
      -16deg,
      transparent 0 9rpx,
      rgba(238, 242, 255, 0.03) 9rpx 10rpx
    );
  border-color: rgba(160, 180, 220, 0.12);
  box-shadow:
    0 12rpx 28rpx rgba(0, 0, 0, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.theme-dark .dense-name {
  color: #c5d0e6;
  text-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.35);
}

.theme-dark .card-mark {
  color: rgba(197, 208, 230, 0.07);
}

.theme-dark .dense-row.tone-rise .dense-row-skin::after {
  background: linear-gradient(90deg, transparent, rgba(255, 107, 122, 0.08));
}

.theme-dark .dense-row.tone-fall .dense-row-skin::after {
  background: linear-gradient(90deg, transparent, rgba(75, 184, 146, 0.08));
}

.theme-dark .dense-row.tone-flat .dense-row-skin::after {
  background: linear-gradient(90deg, transparent, rgba(123, 136, 255, 0.06));
}

.swipe-row {
  margin-bottom: 10rpx;
  border-radius: var(--radius);
  overflow: hidden;
}

.list-gap {
  display: flex;
  flex-direction: column;
}

/* —— 来财水印（黄金设置 / 基金·黄金走势详情共用） —— */
.fortune-wm {
  position: absolute;
  left: 0;
  right: 0;
  top: 42%;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.fortune-wm.is-fill {
  position: relative;
  flex: 1;
  min-height: 420rpx;
  top: auto;
  bottom: auto;
  margin: 0 -8rpx;
}

.fortune-mark {
  position: absolute;
  left: 50%;
  top: 54%;
  transform: translate(-50%, -50%) rotate(-18deg);
  font-size: 220rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
  line-height: 1;
  white-space: nowrap;
  color: rgba(166, 124, 45, 0.1);
  text-shadow:
    0 2rpx 0 rgba(255, 240, 190, 0.12),
    0 18rpx 48rpx rgba(138, 106, 50, 0.05);
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;
}

.fortune-seal {
  position: absolute;
  right: 10%;
  top: 68%;
  transform: rotate(-18deg);
  padding: 10rpx 14rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: rgba(176, 80, 60, 0.14);
  border: 4rpx solid rgba(176, 80, 60, 0.12);
  border-radius: 8rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.fortune-ingot {
  position: absolute;
  width: 160rpx;
  height: 48rpx;
  background: linear-gradient(180deg, rgba(243, 223, 154, 0.22), rgba(166, 124, 45, 0.16));
  clip-path: polygon(12% 0, 88% 0, 100% 100%, 0 100%);
  opacity: 0.32;
}

.fortune-ingot-a {
  left: 8%;
  bottom: 12%;
  transform: rotate(-22deg);
}

.fortune-ingot-b {
  right: 6%;
  top: 28%;
  width: 120rpx;
  height: 36rpx;
  transform: rotate(14deg);
  opacity: 0.24;
}

.theme-dark .fortune-mark {
  color: rgba(232, 201, 122, 0.08);
  text-shadow:
    0 2rpx 0 rgba(255, 220, 140, 0.04),
    0 18rpx 48rpx rgba(0, 0, 0, 0.12);
}

.theme-dark .fortune-seal {
  color: rgba(230, 140, 120, 0.14);
  border-color: rgba(230, 140, 120, 0.12);
}

.theme-dark .fortune-ingot {
  background: linear-gradient(180deg, rgba(232, 201, 122, 0.12), rgba(143, 109, 46, 0.1));
}
