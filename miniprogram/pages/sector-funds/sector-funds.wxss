/* 独立页：整页体榜单（无卡片壳）；跟随 App 深浅主题 */

.sf-shell {
  --sf-mist: #d8e0eb;
  --sf-mist-deep: #c9d4e3;
  --sf-ink: #121a27;
  --sf-mute: #5b677a;
  --sf-line: rgba(18, 26, 39, 0.1);
  --sf-rise: #be123c;
  --sf-fall: #0f766e;
  --sf-ember: #b45309;
  --sf-ember-soft: rgba(180, 83, 9, 0.12);
  --sf-surface: #d8e0eb;
  --sf-sticky: rgba(216, 224, 235, 0.96);
  --sf-rank: rgba(18, 26, 39, 0.35);
  --sf-grad-a: rgba(255, 255, 255, 0.55);
  --sf-grad-b: rgba(180, 83, 9, 0.07);
  --sf-add-border: rgba(180, 83, 9, 0.28);
  --sf-on-bg: rgba(15, 118, 110, 0.1);
  --sf-on-border: rgba(15, 118, 110, 0.28);
  background: var(--sf-surface) !important;
}

.sf-shell.theme-dark {
  --sf-mist: #121a27;
  --sf-mist-deep: #0e1520;
  --sf-ink: #e8eef8;
  --sf-mute: #8b96a8;
  --sf-line: rgba(232, 238, 248, 0.1);
  --sf-rise: #ff6b7a;
  --sf-fall: #3dd6c6;
  --sf-ember: #f0a35a;
  --sf-ember-soft: rgba(240, 163, 90, 0.14);
  --sf-surface: #0e1520;
  --sf-sticky: rgba(14, 21, 32, 0.96);
  --sf-rank: rgba(232, 238, 248, 0.32);
  --sf-grad-a: rgba(80, 110, 160, 0.16);
  --sf-grad-b: rgba(240, 163, 90, 0.08);
  --sf-add-border: rgba(240, 163, 90, 0.35);
  --sf-on-bg: rgba(61, 214, 198, 0.12);
  --sf-on-border: rgba(61, 214, 198, 0.32);
}

.sf-shell .subpage-nav {
  background: transparent;
}

.sf-scroller {
  background: transparent;
}

.sf-page {
  position: relative;
  min-height: 100%;
  padding: 0 0 48rpx;
  color: var(--sf-ink);
  background:
    radial-gradient(120% 70% at 10% -10%, var(--sf-grad-a), transparent 55%),
    radial-gradient(90% 50% at 100% 0%, var(--sf-grad-b), transparent 45%),
    linear-gradient(180deg, var(--sf-mist) 0%, var(--sf-mist-deep) 100%);
  overflow: visible;
  font-family: 'PingFang SC', 'HarmonyOS Sans', 'Noto Sans SC', system-ui, sans-serif;
}

.sf-body {
  position: relative;
  z-index: 1;
}

.sf-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--sf-sticky);
  backdrop-filter: blur(10px);
}

.sf-toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 12rpx;
  border-bottom: 1rpx solid var(--sf-line);
}

.sf-eyebrow {
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 0.02em;
  color: var(--sf-ember);
}

.sf-err {
  position: relative;
  z-index: 1;
  margin: 16rpx 32rpx;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  background: rgba(190, 18, 60, 0.08);
  color: var(--sf-rise);
  font-size: 26rpx;
}

.sf-shell.theme-dark .sf-err {
  background: rgba(255, 107, 122, 0.12);
}

.sf-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  padding: 72rpx 32rpx;
}

.sf-bar {
  width: 72rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--sf-ember), transparent);
  animation: sf-slide 1.1s ease-in-out infinite;
}

@keyframes sf-slide {
  0%,
  100% {
    transform: scaleX(0.45);
    opacity: 0.55;
  }
  50% {
    transform: scaleX(1);
    opacity: 1;
  }
}

.sf-state-t {
  font-size: 30rpx;
  font-weight: 650;
  color: var(--sf-ink);
}

.sf-state-h {
  font-size: 24rpx;
  color: var(--sf-mute);
}

.sf-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx 12rpx;
  border-bottom: 1rpx solid var(--sf-line);
  background: var(--sf-sticky);
}

.sf-h-rank,
.sf-h-name,
.sf-h-pct,
.sf-h-act {
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 0.12em;
  color: var(--sf-mute);
}

.sf-h-rank {
  width: 40rpx;
}

.sf-h-name {
  flex: 1;
}

.sf-h-pct {
  width: 120rpx;
  text-align: right;
}

.sf-h-act {
  width: 44rpx;
}

.sf-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 32rpx;
  border-bottom: 1rpx solid var(--sf-line);
}

.sf-row:last-child {
  border-bottom: 0;
}

.sf-rank {
  width: 40rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--sf-rank);
}

.sf-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sf-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--sf-ink);
}

.sf-code {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  font-variant-numeric: tabular-nums;
  color: var(--sf-mute);
}

.sf-pct {
  flex-shrink: 0;
  width: 120rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.03em;
  color: var(--sf-mute);
}

.sf-pct.rise {
  color: var(--sf-rise);
}

.sf-pct.fall {
  color: var(--sf-fall);
}

.sf-add {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--sf-ember);
  background: var(--sf-ember-soft);
  border: 1rpx solid var(--sf-add-border);
}

.sf-add.is-on {
  color: var(--sf-fall);
  background: var(--sf-on-bg);
  border-color: var(--sf-on-border);
  font-size: 22rpx;
}
