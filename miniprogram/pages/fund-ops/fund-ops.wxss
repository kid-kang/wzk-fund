/* 持仓操作台：票根式四 tab + 流水字段，沿用报头轨而不是行情黄 */

.fund-ops {
  padding-top: 0;
  padding-bottom: 48rpx;
}

.ops-tabs {
  display: flex;
  align-items: stretch;
  margin: 0 4rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.ops-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 620;
  color: var(--muted);
  letter-spacing: 0.08em;
  position: relative;
}

.ops-tab.is-on {
  color: var(--accent);
  font-weight: 760;
}

.ops-tab.is-on::after {
  content: '';
  position: absolute;
  left: 28%;
  right: 28%;
  bottom: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--accent);
}

.ops-fund {
  padding: 22rpx 12rpx 8rpx;
}

.ops-fund-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ops-name {
  font-size: 34rpx;
  font-weight: 780;
  color: var(--ink);
  line-height: 1.3;
}

.ops-code {
  font-size: 24rpx;
  font-weight: 650;
  color: var(--muted);
}

.ops-sip-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
  line-height: 1.4;
  color: var(--accent);
  background: var(--accent-soft);
  transform: translateY(-2rpx);
}

.ops-sip-tag.paused {
  color: var(--muted);
  background: rgba(139, 147, 167, 0.16);
}

.ledger {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  margin: 8rpx 4rpx 0;
  padding: 4rpx 0 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.ledger-cell {
  flex: 1;
  min-width: 0;
  padding: 20rpx 8rpx 16rpx;
}

.ledger-k {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: var(--muted);
}

.ledger-v {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 14rpx;
  min-height: 52rpx;
}

.ledger-yen {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}

.ledger-num {
  font-size: 34rpx;
  font-weight: 760;
  letter-spacing: -0.04em;
  color: var(--ink);
  line-height: 1.05;
  word-break: break-all;
}

.ledger-v.is-empty .ledger-num {
  font-size: 28rpx;
  font-weight: 620;
  letter-spacing: 0.06em;
  color: var(--muted);
}

.ledger-rule {
  width: 1rpx;
  align-self: stretch;
  margin: 24rpx 0 16rpx;
  background: var(--line);
}

.rail {
  padding: 28rpx 8rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.rail-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.rail-code {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--accent);
  opacity: 0.85;
}

.rail-name {
  font-size: 28rpx;
  font-weight: 740;
  color: var(--ink);
  letter-spacing: 0.04em;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 8rpx 0;
}

.cash-row {
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--line);
}

.field-prefix {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--muted);
  line-height: 1;
}

.field-picker {
  flex: 1;
  min-width: 0;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ink);
  background: transparent;
  display: flex;
  align-items: center;
}

.cash-input {
  height: 80rpx;
  font-size: 44rpx;
  font-weight: 500;
}

.field-input.is-ph,
.cash-ph,
.field-ph {
  color: var(--muted);
  opacity: 0.45;
  font-weight: 500;
  font-size: 40rpx;
}

.field-ph {
  font-size: 28rpx;
}

.field-suffix {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 0.08em;
  color: var(--muted);
  padding: 6rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}

.field-tip {
  display: block;
  margin-top: 4rpx;
  margin-bottom: 12rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
}

.fee-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin: 16rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.fee-line.is-sell {
  color: var(--accent);
  font-weight: 650;
}

.fee-input {
  width: 88rpx;
  height: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 740;
  color: var(--accent);
  border-bottom: 2rpx solid var(--accent);
}

.fee-caret {
  font-size: 18rpx;
  opacity: 0.7;
}

.frac-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.frac-chip {
  flex: 1 0 calc((100% - 24rpx) / 3);
  box-sizing: border-box;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

.frac-chip.is-on {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}

.time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 8rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.time-k {
  font-size: 28rpx;
  font-weight: 740;
  color: var(--ink);
}

.time-v {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--ink);
}

.time-v.is-fixed {
  color: var(--muted);
}

.sess-row {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 8rpx 4rpx;
}

.sess-chip {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

.sess-chip.is-on {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}

.err {
  margin: 20rpx 8rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 59, 69, 0.1);
  color: var(--rise);
  font-size: 22rpx;
}

.save-btn {
  margin: 36rpx 8rpx 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 740;
  letter-spacing: 0.06em;
  color: #ffffff;
  border-radius: 999rpx;
  background: var(--accent);
  box-shadow: 0 12rpx 28rpx var(--accent-soft);
}

.save-btn-hover {
  opacity: 0.86;
  transform: scale(0.985);
}

.save-btn.is-busy {
  opacity: 0.7;
}

.ops-log {
  margin: 48rpx 8rpx 0;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--line);
}

.ops-log-title {
  display: block;
  padding: 20rpx 0 8rpx;
  font-size: 28rpx;
  font-weight: 760;
  color: var(--ink);
}

.ops-log-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 88rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ops-log-mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--rise);
}

.ops-log-mark.sell {
  background: #3d5afe;
}

.theme-dark .ops-log-mark.sell {
  background: #8ea2ff;
}

.ops-log-mark.exit {
  background: #0b6b4f;
}

.theme-dark .ops-log-mark.exit {
  background: #4bb892;
}

.ops-log-mark.sip {
  background: var(--accent);
}

.ops-log-mark.pending {
  background: var(--muted);
}

.ops-log-copy {
  flex: 1;
  min-width: 0;
}

.ops-log-type {
  display: block;
  font-size: 24rpx;
  font-weight: 760;
  letter-spacing: 0.06em;
  color: var(--rise);
}

.ops-log-type.sell {
  color: #3d5afe;
}

.theme-dark .ops-log-type.sell {
  color: #8ea2ff;
}

.ops-log-type.exit {
  color: #0b6b4f;
}

.theme-dark .ops-log-type.exit {
  color: #4bb892;
}

.ops-log-type.sip {
  color: var(--accent);
}

.ops-log-type.pending,
.ops-log-amt.pending {
  color: var(--muted);
}

.ops-log-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.ops-log-amt {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 760;
  color: var(--ink);
}

.ops-log-amt.sell {
  color: #3d5afe;
}

.theme-dark .ops-log-amt.sell {
  color: #8ea2ff;
}

.ops-log-amt.exit {
  color: #0b6b4f;
}

.theme-dark .ops-log-amt.exit {
  color: #4bb892;
}

.ops-log-empty {
  display: block;
  padding: 24rpx 0 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
