<page-meta page-style="background-color: {{pageBg}};" background-color="{{pageBg}}" background-color-top="{{pageBg}}"
  background-color-bottom="{{pageBg}}" root-background-color="{{pageBg}}" background-text-style="{{bgTextStyle}}" />

<view class="subpage-root theme-{{theme}}">
  <view class="subpage-nav">
    <app-nav-bar title="{{navTitle}}" theme="{{theme}}" />
  </view>

  <scroll-view class="subpage-scroller" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view class="page theme-{{theme}} fund-form">
      <view class="guide-link" wx:if="{{mode === 'hold' && !codeLocked}}" bindtap="onOpenAddGuide"
        hover-class="guide-link-hover">
        <van-icon name="info-o" size="16px" color="{{theme === 'dark' ? '#ff8a4c' : '#c45c2a'}}" />
        <view class="guide-link-body">
          <text class="guide-link-title">添加前请知晓</text>
          <text class="guide-link-desc">份额确认后再录入 · 收益为何不是 0</text>
        </view>
        <text class="guide-link-arrow mono">›</text>
      </view>

      <view class="mast">
        <text class="mast-kicker mono">{{mode === 'hold' ? (codeLocked ? 'EDIT HOLDING' : 'ADD HOLDING') : (codeLocked ?
          'EDIT WATCH' : 'ADD WATCH')}}</text>
        <text class="mast-name">{{name || (resolving ? '识别中…' : (codeLocked ? '基金持仓' : '输入以下信息'))}}</text>
        <text class="mast-hint" wx:if="{{nameHint}}">{{nameHint}}</text>
      </view>

      <view class="rail">
        <view class="rail-head">
          <text class="rail-code mono">01</text>
          <text class="rail-name">代码</text>
        </view>
        <view class="field-row {{codeLocked ? 'is-locked' : ''}}">
          <input class="field-input mono" type="number" maxlength="6" value="{{code}}" disabled="{{codeLocked}}"
            placeholder="6 位基金代码" placeholder-class="field-ph" bindinput="onCodeInput" />
          <text class="field-suffix" wx:if="{{codeLocked}}">已锁定</text>
        </view>
      </view>

      <view class="rail" wx:if="{{mode === 'hold'}}">
        <view class="rail-head">
          <text class="rail-code mono">02</text>
          <text class="rail-name">当前持仓金额</text>
        </view>

        <view class="field-row">
          <text class="field-prefix">¥</text>
          <input class="field-input mono" type="digit" value="{{amount}}" placeholder="填写确认后的持仓金额"
            placeholder-class="field-ph" bindinput="onAmountInput" />
        </view>
        <text class="field-tip">请用支付宝确认后的当前持仓金额，系统按最新公布净值反算份额</text>
      </view>

      <view class="rail" wx:if="{{mode === 'hold'}}">
        <view class="rail-head">
          <text class="rail-code mono">03</text>
          <text class="rail-name">投入成本</text>
        </view>
        <view class="field-row">
          <text class="field-prefix">¥</text>
          <input class="field-input mono" type="digit" value="{{cost}}" placeholder="请填写投入成本"
            placeholder-class="field-ph" bindinput="onCostInput" />
        </view>
        <text class="field-tip">用于计算持仓收益率</text>
      </view>

      <view class="rail" wx:if="{{mode === 'hold'}}">
        <view class="rail-head">
          <text class="rail-code mono">04</text>
          <text class="rail-name">买入日期</text>
        </view>
        <view class="field-row {{codeReady ? '' : 'is-locked'}}">
          <picker wx:if="{{codeReady}}" class="field-picker" mode="date" value="{{buyDate || today}}"
            end="{{buyDatePickerEnd}}" bindchange="onBuyDateChange">
            <view class="field-input {{buyDate ? '' : 'is-ph'}}">{{buyDate || '选填'}}</view>
          </picker>
          <view wx:else class="field-picker" bindtap="onBuyDateBlocked">
            <view class="field-input is-ph">请先填写基金代码</view>
          </view>
          <text class="field-suffix" wx:if="{{buyDate}}" catchtap="onClearBuyDate">清除</text>
        </view>
        <text class="field-tip">用于展示持有天数、买入点位等，请选交易日</text>
      </view>

      <view class="err" wx:if="{{error}}">{{error}}</view>

      <view class="save-btn {{saving ? 'is-busy' : ''}}" hover-class="save-btn-hover" bindtap="onSubmit">{{saving ?
        '保存中…' : '保存'}}</view>
    </view>
  </scroll-view>
</view>

<van-toast id="van-toast" />