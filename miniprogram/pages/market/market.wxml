<scroll-view
  class="page-scroller"
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  refresher-enabled
  refresher-threshold="{{400}}"
  refresher-default-style="{{theme === 'dark' ? 'white' : 'black'}}"
  refresher-background="{{theme === 'dark' ? '#0b1018' : '#eef1f8'}}"
  refresher-triggered="{{refresherTriggered}}"
  bindrefresherrefresh="onRefresherRefresh"
>
  <view class="page theme-{{theme}}">
    <view class="err" wx:if="{{error}}">{{error}}</view>

    <view class="board" wx:if="{{market}}">
      <view class="glass board-col">
        <view class="col-h rise">
          <text class="col-title">涨幅</text>
          <text class="mono col-stat">{{market.upDown.up}} {{market.upDown.upPctText}}</text>
        </view>
        <view class="s-row" wx:for="{{market.topGainers}}" wx:key="code">
          <text class="s-name">{{item.name}}</text>
          <text class="mono rise">{{item.pctText}}</text>
        </view>
      </view>
      <view class="glass board-col">
        <view class="col-h fall">
          <text class="col-title">跌幅</text>
          <text class="mono col-stat">{{market.upDown.down}} {{market.upDown.downPctText}}</text>
        </view>
        <view class="s-row" wx:for="{{market.topLosers}}" wx:key="code">
          <text class="s-name">{{item.name}}</text>
          <text class="mono fall">{{item.pctText}}</text>
        </view>
      </view>
    </view>

    <view class="index-grid">
      <view
        class="glass index-card"
        wx:for="{{indices}}"
        wx:key="code"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
        bindtap="onOpenIndex"
      >
        <text class="index-name">{{item.name}}</text>
        <text class="mono index-pct {{item.pctClass}}">{{item.pctText}}</text>
      </view>
    </view>
  </view>
</scroll-view>
