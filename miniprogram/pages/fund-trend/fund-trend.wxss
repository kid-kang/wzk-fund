/* 基金走势：对齐金价详情票据报头，强调色用行情 accent */

.fund-trend {
  --ft-ink: var(--ink);
  --ft-bright: var(--accent);
  --ft-soft: var(--accent-soft);
  --ft-line: rgba(79, 93, 255, 0.28);
  position: relative;
  min-height: 100%;
  padding-top: 4rpx;
  overflow: hidden;
}

.fund-trend .trend-fg {
  position: relative;
  z-index: 1;
}

.theme-dark.fund-trend,
.theme-dark .fund-trend {
  --ft-line: rgba(123, 136, 255, 0.28);
}

.ticket {
  position: relative;
  padding: 8rpx 8rpx 12rpx;
  margin-bottom: 2rpx;
}

.ticket-id {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.ticket-meta {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.ticket-code {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 780;
  letter-spacing: 0.06em;
  color: var(--muted);
}

.ticket-sep {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--muted);
  opacity: 0.55;
}

.ticket-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticket-age {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--muted);
  opacity: 0.8;
}

.ticket-rule {
  margin-top: 16rpx;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    var(--ft-bright) 0%,
    var(--ft-line) 42%,
    transparent 100%
  );
  opacity: 0.9;
}

.range-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 4rpx 0 8rpx;
}

.range-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 96rpx;
  min-height: 72rpx;
  padding: 10rpx 20rpx;
  margin-right: 10rpx;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
  vertical-align: top;
  box-sizing: border-box;
}

.range-chip:last-child {
  margin-right: 0;
}

.range-label {
  font-size: 24rpx;
  font-weight: 650;
  color: var(--muted);
  line-height: 1.2;
}

.range-pct {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 740;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.range-pct.flat {
  color: var(--muted);
}

.range-chip.is-on {
  background: var(--ft-soft);
  border-color: var(--ft-line);
}

.range-chip.is-on .range-label {
  color: var(--ft-ink);
  font-weight: 740;
}

.range-chip.is-on .range-pct {
  font-weight: 780;
}

.err {
  margin: 8rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 59, 69, 0.1);
  color: var(--rise);
  font-size: 22rpx;
}

.chart-stage {
  margin-top: 4rpx;
  margin-left: -8rpx;
  margin-right: -8rpx;
  padding: 4rpx 0 0;
}

/* —— 前十大持仓 —— */
.hold-block {
  margin-top: 28rpx;
  padding: 8rpx 4rpx 40rpx;
  border-top: 1rpx solid var(--line);
}

.hold-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 4rpx 12rpx;
}

.hold-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.hold-code {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--ft-bright);
  opacity: 0.85;
}

.hold-title {
  font-size: 28rpx;
  font-weight: 740;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.hold-sub {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx 16rpx;
}

.hold-hint {
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.35;
}

.hold-yoy {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.alloc-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0 14rpx;
}

.alloc-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-height: 44rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: var(--ft-soft);
  border: 1rpx solid var(--ft-line);
}

.alloc-label {
  font-size: 20rpx;
  font-weight: 650;
  color: var(--muted);
}

.alloc-w {
  font-size: 22rpx;
  font-weight: 740;
  color: var(--ink);
  letter-spacing: -0.02em;
}

.alloc-chg {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.hold-cols {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 4rpx 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: var(--muted);
  opacity: 0.8;
}

.hold-col-name {
  flex: 1.15;
  min-width: 0;
}

.hold-col-industry {
  flex: 0.95;
  min-width: 0;
  text-align: right;
}

.hold-col-w {
  width: 128rpx;
  flex-shrink: 0;
  text-align: right;
}

.hold-err {
  margin: 8rpx 0;
  padding: 14rpx 8rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.hold-list {
  display: flex;
  flex-direction: column;
}

.hold-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 4rpx;
  border-top: 1rpx dashed rgba(122, 132, 148, 0.28);
}

.theme-dark .hold-row {
  border-top-color: rgba(139, 147, 167, 0.22);
}

.hold-main {
  flex: 1.15;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hold-rank {
  width: 32rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--muted);
  opacity: 0.75;
}

.hold-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hold-name {
  font-size: 26rpx;
  font-weight: 680;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hold-stock-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.hold-stock {
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 0.04em;
}

.hold-stock-y {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.hold-industry-wrap {
  flex: 0.95;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.hold-industry {
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hold-industry-l1 {
  max-width: 100%;
  font-size: 18rpx;
  color: var(--muted);
  opacity: 0.75;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hold-weight-wrap {
  width: 128rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.hold-weight {
  font-size: 24rpx;
  font-weight: 740;
  color: var(--ft-ink);
  text-align: right;
  letter-spacing: -0.02em;
}

.hold-wchg {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.rise {
  color: var(--rise);
}

.fall {
  color: var(--fall);
}

.flat {
  color: var(--muted);
}
