/* 基金走势：对齐金价详情票据报头，强调色用行情 accent */

.fund-trend {
  --ft-ink: var(--ink);
  --ft-bright: var(--accent);
  --ft-soft: var(--accent-soft);
  --ft-line: rgba(79, 93, 255, 0.28);
  position: relative;
  min-height: 100%;
  padding-top: 4rpx;
  overflow: hidden;
}

.fund-trend .trend-fg {
  position: relative;
  z-index: 1;
}

.theme-dark.fund-trend,
.theme-dark .fund-trend {
  --ft-line: rgba(123, 136, 255, 0.28);
}

.ticket {
  position: relative;
  padding: 8rpx 8rpx 12rpx;
  margin-bottom: 2rpx;
}

.ticket-id {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.ticket-meta {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.ticket-code {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 780;
  letter-spacing: 0.06em;
  color: var(--muted);
}

.ticket-sep {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--muted);
  opacity: 0.55;
}

.ticket-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticket-age {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--muted);
  opacity: 0.8;
}

.ticket-rule {
  margin-top: 16rpx;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    var(--ft-bright) 0%,
    var(--ft-line) 42%,
    transparent 100%
  );
  opacity: 0.9;
}

.range-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 4rpx 0 8rpx;
}

.range-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 96rpx;
  min-height: 72rpx;
  padding: 10rpx 20rpx;
  margin-right: 10rpx;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
  vertical-align: top;
  box-sizing: border-box;
}

.range-chip:last-child {
  margin-right: 0;
}

.range-label {
  font-size: 24rpx;
  font-weight: 650;
  color: var(--muted);
  line-height: 1.2;
}

.range-pct {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 740;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.range-pct.flat {
  color: var(--muted);
}

.range-chip.is-on {
  background: var(--ft-soft);
  border-color: var(--ft-line);
}

.range-chip.is-on .range-label {
  color: var(--ft-ink);
  font-weight: 740;
}

.range-chip.is-on .range-pct {
  font-weight: 780;
}

.err {
  margin: 8rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 59, 69, 0.1);
  color: var(--rise);
  font-size: 22rpx;
}

.chart-stage {
  margin-top: 4rpx;
  margin-left: -8rpx;
  margin-right: -8rpx;
  padding: 4rpx 0 0;
}

/* —— 重仓股票（对齐小倍） —— */
.hold-block {
  margin-top: 24rpx;
  padding: 0 0 40rpx;
}

.hold-card {
  padding: 22rpx 18rpx 8rpx;
  border-radius: 24rpx;
  background: var(--panel);
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 28rpx rgba(20, 28, 40, 0.04);
}

.theme-dark .hold-card {
  background: rgba(255, 255, 255, 0.04);
  box-shadow: none;
}

.hold-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx 16rpx;
}

.hold-title-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  flex-wrap: wrap;
}

.hold-title {
  font-size: 30rpx;
  font-weight: 740;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.hold-total {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
}

.hold-quarter {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 550;
  color: var(--muted);
}

.hold-cols {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 8rpx 12rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.hold-col {
  flex-shrink: 0;
}

.hold-col-name {
  flex: 1.2;
  min-width: 0;
  text-align: left;
}

.hold-col-chg {
  width: 112rpx;
  text-align: right;
}

.hold-col-w {
  width: 112rpx;
  text-align: right;
}

.hold-col-qw {
  width: 140rpx;
  text-align: right;
}

.hold-err {
  margin: 8rpx 0 16rpx;
  padding: 14rpx 8rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.hold-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-bottom: 8rpx;
}

.hold-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
}

.hold-row.row-rise {
  background: rgba(215, 38, 61, 0.06);
}

.hold-row.row-fall {
  background: rgba(11, 107, 79, 0.06);
}

.theme-dark .hold-row.row-rise {
  background: rgba(255, 107, 122, 0.1);
}

.theme-dark .hold-row.row-fall {
  background: rgba(75, 184, 146, 0.1);
}

.hold-cell {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 680;
  letter-spacing: -0.02em;
}

.hold-cell.hold-col-name {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.hold-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hold-stock {
  font-size: 20rpx;
  font-weight: 550;
  color: var(--muted);
  letter-spacing: 0.02em;
}

.hold-col-chg,
.hold-col-w,
.hold-col-qw {
  font-variant-numeric: tabular-nums;
}

.hold-col-w {
  color: var(--ink);
  font-weight: 700;
}

.rise {
  color: var(--rise);
}

.fall {
  color: var(--fall);
}

.flat {
  color: var(--muted);
}
