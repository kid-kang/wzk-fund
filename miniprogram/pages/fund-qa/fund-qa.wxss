.qa-page {
  position: relative;
  z-index: 1;
  padding: 8rpx 8rpx 72rpx;
}

.qa-intro {
  padding: 12rpx 8rpx 28rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.qa-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 760;
  letter-spacing: 0.14em;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.qa-lead {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--muted);
}

.qa-align {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(46, 168, 122, 0.1);
  border: 1rpx solid rgba(46, 168, 122, 0.28);
}

.theme-dark .qa-align {
  background: rgba(72, 190, 140, 0.12);
  border-color: rgba(72, 190, 140, 0.28);
}

.qa-align-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink);
}

.qa-item {
  margin-top: 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.qa-q {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 8rpx;
}

.qa-q-hover {
  opacity: 0.82;
}

.qa-q-mark {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.qa-q-text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.35;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.qa-chevron {
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--muted);
  line-height: 1;
}

.qa-a {
  padding: 0 8rpx 32rpx 80rpx;
}

.qa-p {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.qa-em {
  color: var(--accent);
  font-weight: 700;
}

.qa-caption {
  display: block;
  margin: 8rpx 0 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 0.04em;
}

.qa-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--muted);
}

.qa-legal {
  display: block;
  margin-top: 40rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

/* bullets with icon tiles */
.qa-bullets {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.qa-bullet {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.qa-ico {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qa-ico.is-est {
  background: rgba(79, 93, 255, 0.14);
}

.qa-ico.is-ok {
  background: rgba(46, 168, 122, 0.16);
}

.theme-dark .qa-ico.is-est {
  background: rgba(123, 136, 255, 0.2);
}

.theme-dark .qa-ico.is-ok {
  background: rgba(72, 190, 140, 0.2);
}

.qa-ico-glyph {
  font-size: 22rpx;
  font-weight: 780;
  color: var(--ink);
}

.qa-ico.is-ok .qa-ico-glyph {
  color: #1f9a6a;
}

.theme-dark .qa-ico.is-ok .qa-ico-glyph {
  color: #5fd4a2;
}

.qa-bullet-text {
  flex: 1;
  min-width: 0;
}

.qa-b-title {
  display: block;
  font-size: 26rpx;
  font-weight: 720;
  color: var(--ink);
  margin-bottom: 4rpx;
}

.qa-b-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted);
}

/* timeline */
.qa-timeline {
  position: relative;
  padding-left: 8rpx;
  margin-bottom: 8rpx;
}

.qa-tl-item {
  position: relative;
  display: flex;
  gap: 18rpx;
  padding-bottom: 20rpx;
}

.qa-tl-item:last-child {
  padding-bottom: 0;
}

.qa-tl-item:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(79, 93, 255, 0.45), rgba(122, 132, 148, 0.2));
}

.theme-dark .qa-tl-item:not(:last-child)::before {
  background: linear-gradient(180deg, rgba(123, 136, 255, 0.5), rgba(139, 147, 167, 0.2));
}

.qa-tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--bg);
}

.qa-tl-dot.is-est {
  background: var(--accent);
}

.qa-tl-dot.is-ok {
  background: #2ea87a;
}

.qa-tl-dot.is-mute {
  background: #8a94a8;
}

.qa-tl-card {
  flex: 1;
  min-width: 0;
  padding: 12rpx 16rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(122, 132, 148, 0.08);
  border: 1rpx solid rgba(122, 132, 148, 0.14);
}

.theme-dark .qa-tl-card {
  background: rgba(139, 147, 167, 0.1);
  border-color: rgba(139, 147, 167, 0.16);
}

.qa-tl-time {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 4rpx;
}

.qa-tl-title {
  display: block;
  font-size: 26rpx;
  font-weight: 720;
  color: var(--ink);
  margin-bottom: 4rpx;
}

.qa-tl-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--muted);
}

/* demo badge：复用全局 .confirmed-badge，与持仓一致 */
.qa-demo-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}

.qa-demo-note {
  font-size: 22rpx;
  color: var(--muted);
}

/* callout */
.qa-callout {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--accent-soft);
  border: 1rpx solid rgba(79, 93, 255, 0.22);
  margin: 8rpx 0 4rpx;
}

.theme-dark .qa-callout {
  border-color: rgba(123, 136, 255, 0.28);
}

.qa-callout-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink);
}

/* formula */
.qa-formula {
  padding: 20rpx 22rpx;
  margin: 4rpx 0 18rpx;
  border-radius: 16rpx;
  background: linear-gradient(
    135deg,
    rgba(79, 93, 255, 0.12),
    rgba(79, 93, 255, 0.04)
  );
  border: 1rpx solid rgba(79, 93, 255, 0.22);
}

.qa-formula.is-soft {
  background: rgba(122, 132, 148, 0.1);
  border-color: rgba(122, 132, 148, 0.2);
}

.theme-dark .qa-formula {
  background: linear-gradient(
    135deg,
    rgba(123, 136, 255, 0.16),
    rgba(123, 136, 255, 0.05)
  );
  border-color: rgba(123, 136, 255, 0.28);
}

.qa-formula-label {
  display: block;
  font-size: 18rpx;
  font-weight: 760;
  letter-spacing: 0.12em;
  color: var(--accent);
  margin-bottom: 8rpx;
}

.qa-formula-main {
  display: block;
  font-size: 26rpx;
  font-weight: 720;
  line-height: 1.45;
  color: var(--ink);
}

/* table */
.qa-table {
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(122, 132, 148, 0.2);
}

.theme-dark .qa-table {
  border-color: rgba(139, 147, 167, 0.22);
}

.qa-tr {
  display: flex;
  gap: 8rpx;
  padding: 14rpx 12rpx;
  border-top: 1rpx solid rgba(122, 132, 148, 0.14);
}

.qa-tr:first-child {
  border-top: none;
}

.qa-tr.is-head {
  background: rgba(122, 132, 148, 0.1);
}

.theme-dark .qa-tr {
  border-top-color: rgba(139, 147, 167, 0.16);
}

.theme-dark .qa-tr.is-head {
  background: rgba(139, 147, 167, 0.12);
}

.qa-td {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--ink);
}

.qa-tr.is-head .qa-td {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--muted);
}

.qa-td.is-wide {
  flex: 1.55;
}

.qa-td.is-up {
  color: #c0392b;
  font-weight: 740;
}

/* async chips */
.qa-chips {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.qa-chip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(122, 132, 148, 0.08);
  border: 1rpx solid rgba(122, 132, 148, 0.14);
}

.theme-dark .qa-chip {
  background: rgba(139, 147, 167, 0.1);
  border-color: rgba(139, 147, 167, 0.16);
}

.qa-chip-name {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 720;
  color: var(--ink);
}

.qa-chip-date {
  min-width: 88rpx;
  padding: 6rpx 12rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 740;
  color: #c0392b;
  background: rgba(192, 57, 43, 0.1);
  border: 1rpx solid rgba(192, 57, 43, 0.22);
}

.qa-chip-sub {
  flex: 1;
  font-size: 22rpx;
  color: var(--muted);
}


/* add-hold guide blocks */
/* 添加持仓说明：步骤 + 对比图 + 时间线 */
.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.guide-step {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.guide-step-num {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 760;
  color: #ffffff;
  background: var(--accent);
  margin-top: 2rpx;
}

.guide-step-body {
  flex: 1;
  min-width: 0;
}

.guide-step-title {
  display: block;
  font-size: 26rpx;
  font-weight: 720;
  color: var(--ink);
  margin-bottom: 4rpx;
}

.guide-step-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--muted);
}

.guide-caption {
  display: block;
  margin: 4rpx 0 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--muted);
}

.guide-compare {
  display: flex;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.guide-compare-col {
  flex: 1;
  min-width: 0;
  padding: 14rpx 12rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(122, 132, 148, 0.18);
}

.theme-dark .guide-compare-col {
  background: rgba(16, 20, 28, 0.35);
  border-color: rgba(139, 147, 167, 0.2);
}

.guide-compare-col.is-bad {
  border-color: rgba(215, 38, 61, 0.22);
}

.guide-compare-col.is-good {
  border-color: rgba(46, 168, 122, 0.28);
}

.guide-compare-tag {
  display: block;
  font-size: 20rpx;
  font-weight: 740;
  margin-bottom: 12rpx;
  color: var(--muted);
}

.guide-compare-col.is-bad .guide-compare-tag {
  color: #c0392b;
}

.guide-compare-col.is-good .guide-compare-tag {
  color: #1f9a6a;
}

.guide-compare-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  height: 120rpx;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.guide-bar {
  flex: 1;
  min-width: 0;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 6rpx;
}

.guide-bar.is-mute {
  background: rgba(122, 132, 148, 0.22);
}

.guide-bar.is-warn {
  background: rgba(215, 38, 61, 0.55);
}

.guide-bar.is-ok {
  background: rgba(46, 168, 122, 0.55);
}

.guide-bar.is-accent {
  background: var(--accent);
}

.guide-bar-label {
  font-size: 16rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  transform: scale(0.92);
}

.guide-compare-foot {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--muted);
}

.guide-timeline {
  position: relative;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.guide-tl-item {
  position: relative;
  display: flex;
  gap: 14rpx;
  padding-bottom: 16rpx;
}

.guide-tl-item:last-child {
  padding-bottom: 0;
}

.guide-tl-item:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 26rpx;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(79, 93, 255, 0.4), rgba(122, 132, 148, 0.18));
}

.theme-dark .guide-tl-item:not(:last-child)::before {
  background: linear-gradient(180deg, rgba(123, 136, 255, 0.45), rgba(139, 147, 167, 0.18));
}

.guide-tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
  box-sizing: border-box;
  border: 4rpx solid transparent;
  background: #8a94a8;
}

.guide-tl-dot.is-ok {
  background: #2ea87a;
}

.guide-tl-dot.is-accent {
  background: var(--accent);
}

.guide-tl-card {
  flex: 1;
  min-width: 0;
  padding: 10rpx 14rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(122, 132, 148, 0.14);
}

.theme-dark .guide-tl-card {
  background: rgba(16, 20, 28, 0.32);
  border-color: rgba(139, 147, 167, 0.16);
}

.guide-tl-time {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 2rpx;
}

.guide-tl-title {
  display: block;
  font-size: 24rpx;
  font-weight: 720;
  color: var(--ink);
  margin-bottom: 2rpx;
}

.guide-tl-desc {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--muted);
}

.guide-formula {
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(79, 93, 255, 0.2);
}

.theme-dark .guide-formula {
  background: rgba(16, 20, 28, 0.32);
  border-color: rgba(123, 136, 255, 0.28);
}

.guide-formula-label {
  display: block;
  font-size: 18rpx;
  font-weight: 760;
  letter-spacing: 0.1em;
  color: var(--accent);
  margin-bottom: 6rpx;
}

.guide-formula-main {
  display: block;
  font-size: 24rpx;
  font-weight: 720;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.guide-formula-sub {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--muted);
}

.guide-example {
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(122, 132, 148, 0.16);
}

.theme-dark .guide-example {
  background: rgba(16, 20, 28, 0.32);
  border-color: rgba(139, 147, 167, 0.18);
}

.guide-example-title {
  display: block;
  font-size: 22rpx;
  font-weight: 720;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.guide-example-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-top: 1rpx dashed rgba(122, 132, 148, 0.2);
}

.guide-example-row:first-of-type {
  border-top: none;
  padding-top: 0;
}

.guide-example-k {
  font-size: 22rpx;
  color: var(--muted);
}

.guide-example-v {
  font-size: 24rpx;
  font-weight: 720;
  color: var(--ink);
}

.guide-example-v.is-up {
  color: #c0392b;
}

.guide-example-row.is-result .guide-example-k {
  font-weight: 700;
  color: var(--ink);
}

.guide-example-note {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: var(--muted);
}
